{
  "mcpServers": {
    "serena": { "command": "uvx", "args": ["--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server", "--context=desktop-app", "--language-backend", "JetBrains", "--project-from-cwd"] },
    "vestige": { "command": "vestige-mcp" },
    "context7": { "command": "npx", "args": ["-y", "@upstash/context7-mcp@latest"] },
    "tavily": { "command": "npx", "args": ["-y", "tavily-mcp@latest"], "env": { "TAVILY_API_KEY": "${TAVILY_API_KEY}" } },
    "fetch": { "command": "uvx", "args": ["--with", "mcp<2", "mcp-server-fetch"] },
    "sequential-thinking": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-sequential-thinking@latest"] },
    "chrome-devtools": { "command": "npx", "args": ["-y", "chrome-devtools-mcp@latest"] }
  }
}
